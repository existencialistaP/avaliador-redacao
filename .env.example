# Copie para .env e preencha. O Bun carrega este arquivo sozinho; o app nunca imprime o valor.
# Pelo menos uma chave é necessária. As três são grátis e todas aceitam imagem.

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter: https://openrouter.ai/keys (modelos :free custam $0)
OPENROUTER_API_KEY=

# Groq: https://console.groq.com/keys
GROQ_API_KEY=

# Opcional
PORT=8787
# Origens do front quando hospedado em outro domínio, separadas por vírgula.
# Sem isso, só a própria origem pode chamar a API.
# CORS_ORIGINS=https://meu-avaliador.pages.dev,http://localhost:5173
# false = sobe só a API (front estático em outro host)
# SERVE_FRONT=true
